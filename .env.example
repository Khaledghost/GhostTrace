# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
PUBLIC_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001
TRUST_PROXY=true

# Reverse-proxy to your real upstream API (optional)
# TARGET_ORIGIN=http://mock-backend:3002

# ─── Auth (first admin created via /setup.html on first run) ─────────────────
JWT_SECRET=change-me-use-openssl-rand-hex-32

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_ENABLED=true
DB_REQUIRED=true
DB_HOST=postgres
DB_PORT=5432
DB_NAME=dna
DB_USER=postgres
DB_PASS=change-me-strong-db-password
DB_SYNC=true
DB_POOL_MAX=10
DB_CONNECT_RETRIES=10
DB_CONNECT_DELAY_MS=3000
DB_WAIT_ATTEMPTS=30
DB_WAIT_DELAY_MS=2000

# ─── AI Providers (configure in UI or via env — first match becomes default) ─
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# xAI Grok (OpenAI-compatible)
GROK_API_KEY=
GROK_MODEL=grok-2-latest

# Ollama (local — no API key)
OLLAMA_ENABLED=false
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# Custom OpenAI-compatible (LM Studio, vLLM, etc.)
# CUSTOM_AI_API_KEY=
# CUSTOM_AI_BASE_URL=http://localhost:8080/v1
# CUSTOM_AI_MODEL=local-model

# Live AI on request logs
AI_LIVE_LOGS=true
AI_TIMEOUT_MS=60000
LOG_MAX_ENTRIES=2000

# ─── Security middleware ──────────────────────────────────────────────────────
BLOCK_ON_THREAT=true
BLOCK_RISK_THRESHOLD=70
RATE_LIMIT=120
SIGMA_THRESHOLD=2.5
MAX_FAILED_ATTEMPTS=5

# ─── Monitoring ───────────────────────────────────────────────────────────────
MONITOR_POLL_MS=10000

# ─── Docker Compose (host ports) ──────────────────────────────────────────────
APP_PUBLISH_PORT=3001
NGINX_HTTP_PORT=80
IMAGE_TAG=latest

# ─── Redis (optional — enable with: docker compose --profile redis up) ───────
# REDIS_URL=redis://redis:6379
