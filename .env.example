# GhostTrace Environment Variables

# ==============================================================================
# ALL OPTIONAL - No Configuration Required!
# ==============================================================================
# 
# GhostTrace works out of the box with ZERO configuration!
# 
# ✅ Embedded SQLite database (no external DB needed)
# ✅ Private dashboard (localhost only by default)
# ✅ Secure by default
#
# On first run:
#   1. Visit http://localhost:3001
#   2. You'll see a setup page
#   3. Create your admin account
#   4. Done!
#

# ==============================================================================
# OPTIONAL - Admin Credentials (Auto-create on startup)
# ==============================================================================

# GHOST_ADMIN_EMAIL=admin@example.com
# GHOST_ADMIN_PASS=secure-password

# ==============================================================================
# OPTIONAL - Server Configuration
# ==============================================================================

# Dashboard server port (default: 3001)
# GHOST_PORT=3001

# ==============================================================================
# OPTIONAL - Dashboard Security
# ==============================================================================

# Make dashboard public (default: false - localhost only)
# WARNING: Only enable if using IP whitelist or behind firewall!
# GHOST_DASHBOARD_PUBLIC=false

# IP Whitelist (comma-separated)
# Examples:
#   Single IP:     GHOST_DASHBOARD_IPS=192.168.1.100
#   Multiple:      GHOST_DASHBOARD_IPS=192.168.1.100,10.0.0.50
#   CIDR range:    GHOST_DASHBOARD_IPS=192.168.1.0/24
#   Wildcards:     GHOST_DASHBOARD_IPS=192.168.*.*
# GHOST_DASHBOARD_IPS=

# Dashboard rate limit (requests per 15 minutes, default: 100)
# GHOST_DASHBOARD_RATE_LIMIT=100

# Trust proxy headers (enable if behind Nginx/Apache)
# TRUST_PROXY=false

# ==============================================================================
# OPTIONAL - Security Configuration
# ==============================================================================

# Risk score threshold for blocking (0-100, default: 70)
# GHOST_BLOCK_THRESHOLD=70

# Maximum requests per minute per user (default: 120)
# GHOST_RATE_LIMIT=120

# Enable blocking on threat detection (default: true)
# GHOST_BLOCK_ON_THREAT=true

# ==============================================================================
# OPTIONAL - Encryption (recommended for production)
# ==============================================================================
#
# If not set, GhostTrace will generate and store a key in ./data/ghosttrace.key
# DATA_ENCRYPTION_KEY=
#
# Set to true to fail startup if no key is provided/generated
# GHOST_REQUIRE_ENCRYPTION=false
#
# Optional custom key file path
# GHOST_ENCRYPTION_KEY_PATH=

# ==============================================================================
# OPTIONAL - Database Configuration
# ==============================================================================
# 
# ✅ SQLITE IS DEFAULT - No external database required!
# 
# GhostTrace uses embedded SQLite database by default.
# Configure external database only if you need:
#   - Multiple instances sharing data
#   - Advanced replication
#   - Very high write volumes

# SQLite (default - embedded database)
# GHOST_DATA_DIR=./data
# GHOST_DB_PATH=./data/ghosttrace.sqlite

# External Database (PostgreSQL/MySQL)
# Only needed if you want external database instead of SQLite
# GHOST_DB_TYPE=postgres
# GHOST_DB_HOST=localhost
# GHOST_DB_PORT=5432
# GHOST_DB_NAME=ghosttrace
# GHOST_DB_USER=postgres
# GHOST_DB_PASS=password
# GHOST_DB_SYNC=true

# ==============================================================================
# OPTIONAL - AI Configuration
# ==============================================================================

# AI provider (openai, anthropic, gemini, ollama, custom)
# GHOST_AI_PROVIDER=openai
# GHOST_AI_KEY=sk-your-api-key
# GHOST_AI_MODEL=gpt-4o-mini

# ==============================================================================
# PRODUCTION RECOMMENDATIONS
# ==============================================================================
# 
# For production deployments:
# 
# 1. Security:
#    - Set GHOST_DASHBOARD_IPS to your office/VPN IPs
#    - Keep GHOST_DASHBOARD_PUBLIC=false
#    - Use strong admin password
#    - Enable TRUST_PROXY if behind Nginx
# 
# 2. Database:
#    - SQLite is fine for most use cases
#    - Use PostgreSQL for multiple instances
#    - Backup ./data/ghosttrace.sqlite regularly
# 
# 3. Deployment:
#    - Run behind Nginx with SSL
#    - Use firewall rules
#    - Monitor access logs
# 
# See DASHBOARD_SECURITY.md for complete setup guide.
#
