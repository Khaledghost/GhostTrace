{
  "name": "ghost-trace",
  "version": "2.1.0",
  "description": "Open-source behavioral detection & response (BDR) platform for SOC and MDR teams",
  "main": "server.js",
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*"
    ]
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:exe": "pkg . --targets node18-linux-x64,node18-win-x64",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "docker:logs": "docker compose logs -f app",
    "docker:demo": "docker compose --profile demo up -d --build",
    "docker:prod": "docker compose --profile production up -d --build"
  },
  "keywords": [
    "threat-detection",
    "behavioral-analytics",
    "security"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.8.1",
    "geoip-lite": "^2.0.2",
    "helmet": "^7.0.0",
    "http-proxy-middleware": "^2.0.9",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.29.4",
    "mongoose": "^9.6.2",
    "mysql2": "^3.22.3",
    "node-fetch": "^3.3.2",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "pkg": "^5.8.1"
  }
}