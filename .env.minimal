# ZERO CONFIGURATION NEEDED!
# 
# GhostTrace works immediately without any .env file.
# Just run it and visit http://localhost:3001 to create your admin account.
#
# This file shows optional settings you CAN configure if you want to.

# Optional: Auto-create admin user on startup (otherwise use setup page)
# GHOST_ADMIN_EMAIL=admin@test.com
# GHOST_ADMIN_PASS=test12345

# Optional: Change dashboard port (default: 3001)
# GHOST_PORT=3001

# Optional: Adjust security (defaults are fine)
# GHOST_BLOCK_THRESHOLD=70
# GHOST_RATE_LIMIT=120

# That's it! Everything else has sensible defaults.
